# Static-only composition of the upstream OpenHarmony SDK templates. Metadata
# is generated by the upstream parse_sdk_description.py before GN. This file
# deliberately does not instantiate the upstream NDK validation/signing graph.

import("//build/ohos/build_var.gni")
import("//build/ohos/sdk/sdk.gni")
import("//.arkdown-static-sdk/generated/ohos_sdk_modules.gni")

generated_sdk_module_install_paths =
    "//.arkdown-static-sdk/generated/ohos_sdk_install_paths.json"
static_ets_modules = ohos_sdk_modules.ets

if (sdk_platform == "linux") {
  make_linux_sdk_modules("arkdown_ets_static") {
    sdk_type = "ets"
    sdk_modules = static_ets_modules.linux
    zipfile_name = "ets-linux-${arch}.zip"
  }
  static_sdk_system = "linux"
} else if (sdk_platform == "win") {
  make_windows_sdk_modules("arkdown_ets_static") {
    sdk_type = "ets"
    sdk_modules = static_ets_modules.windows
    zipfile_name = "ets-windows-${arch}.zip"
  }
  static_sdk_system = "windows"
} else if (sdk_platform == "mac") {
  make_darwin_sdk_modules("arkdown_ets_static") {
    sdk_type = "ets"
    sdk_modules = static_ets_modules.darwin
    zipfile_name = "ets-darwin-${arch}.zip"
  }
  static_sdk_system = "darwin"
} else {
  assert(false, "unsupported static SDK platform: ${sdk_platform}")
}

action_with_pydeps("generate_static_sdk_notice") {
  deps = [ ":arkdown_ets_static" ]
  script = "//build/ohos/notice/merge_notice_files.py"
  depfile = "$target_gen_dir/$target_name.d"
  notice_archive = "${sdk_notice_archive_dir}/${static_sdk_system}-ets.zip"
  inputs = [ notice_archive ]
  outputs = [
    sdk_notice_txt,
    sdk_notice_gz,
  ]
  args = [
    "--image-name",
    "sdk",
    "--notice-root-dir",
    rebase_path(sdk_notice_dir, root_build_dir),
    "--output-notice-txt",
    rebase_path(sdk_notice_txt, root_build_dir),
    "--output-notice-gz",
    rebase_path(sdk_notice_gz, root_build_dir),
    "--notice-title",
    "Notices for files contained in SDK in this directory:",
    "--static-library-notice-dir",
    rebase_path(static_libraries_notice_dir, root_build_dir),
    "--target-cpu",
    target_cpu,
    "--depfile",
    rebase_path(depfile, root_build_dir),
    "--collected-notice-zipfile",
    rebase_path(notice_archive, root_build_dir),
  ]
}

action_with_pydeps("add_static_sdk_notice") {
  deps = [ ":generate_static_sdk_notice" ]
  script = "//build/ohos/sdk/add_notice_file.py"
  output_stamp = "$target_gen_dir/$target_name.stamp"
  depfile = "$target_gen_dir/$target_name.d"
  inputs = [ sdk_notice_txt ]
  outputs = [ output_stamp ]
  args = [
    "--sdk-notice-file",
    rebase_path(sdk_notice_txt, root_build_dir),
    "--sdk-archive-dir",
    rebase_path("${product_output_dir}/${product_name}", root_build_dir),
    "--output",
    rebase_path(output_stamp, root_build_dir),
    "--depfile",
    rebase_path(depfile, root_build_dir),
    "--skip-pattern",
    "native",
  ]
}

group("arkdown_static_sdk") {
  deps = [ ":arkdown_ets_static" ]
  if (enable_process_notice) {
    deps += [ ":add_static_sdk_notice" ]
  }
}
